# Скопируйте в .env и заполните значениями из вашего проекта Supabase
# (Project Settings -> API).
#
# ВАЖНО: сюда подставляется ТОЛЬКО публичный anon-ключ. service_role и любые
# секретные ключи никогда не должны попадать в .env, фронтенд и репозиторий.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
